<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.mmck.fxui.MainViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header">
            <Label styleClass="brand-badge" text="mmck" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="themeToggleButton" onAction="#onToggleTheme" styleClass="ghost" text="Tema: oscuro" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="root">
            <VBox spacing="16" style="-fx-padding: 28 28 28 28;" styleClass="root">

                <VBox spacing="12" styleClass="card">
                    <Label styleClass="card-title" text="Exportar lista de mods" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-name" text="Directorio:" />
                        <TextField fx:id="directoryField" promptText="Carpeta con los mods..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBrowseDirectory" styleClass="secondary" text="Buscar" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-name" text="Nombre del archivo:" />
                        <TextField fx:id="filenameField" promptText="mods-list (opcional)" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Button onAction="#onExport" prefWidth="120" text="Exportar" />
                    </HBox>
                </VBox>

                <VBox spacing="12" styleClass="card">
                    <Label styleClass="card-title" text="Comparar mods" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-name" text="Archivo base:" />
                        <TextField fx:id="baseFileField" promptText="Lista base (.txt)..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBrowseBase" styleClass="secondary" text="Buscar" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-name" text="Archivo destino:" />
                        <TextField fx:id="targetFileField" promptText="Lista destino (.txt)..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBrowseTarget" styleClass="secondary" text="Buscar" />
                    </HBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Button onAction="#onCompare" prefWidth="120" text="Comparar" />
                    </HBox>
                </VBox>

                <VBox fx:id="resultsCard" managed="false" spacing="12" styleClass="card" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="card-title" text="Diferencias" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="summaryPill" styleClass="pill-blue" text="0 mods" />
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="220">
                        <VBox fx:id="diffList" spacing="6" />
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-text" text="Listo" />
        </HBox>
    </bottom>
</BorderPane>
